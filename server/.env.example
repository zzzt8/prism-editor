# ==============================================================
# API Authentication (mall Trust Mode)
# ==============================================================
# Secret for API authentication (server-to-server)
# Use a strong random value in production
PRISM_API_SECRET=dev-secret

# ==============================================================
# Database connection
# ==============================================================
# SQLite (default for local dev):
DATABASE_URL="file:./dev.db"
# PostgreSQL (for production):
# DATABASE_URL="postgresql://user:password@localhost:5432/prism"

# ==============================================================
# Server
# ==============================================================
PORT=3001

# ==============================================================
# CORS
# ==============================================================
# Allow all origins in development; RESTRICT IN PRODUCTION
# For production, set to your mall frontend domain
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"

# ==============================================================
# Environment
# ==============================================================
NODE_ENV=development

# ==============================================================
# OSS / Cloud Storage (Cloudflare R2 or AWS S3)
# ==============================================================
# Set OSS_ENABLED=true to enable cloud storage for large node packages
# When disabled (default), all manifests are stored in the database
OSS_ENABLED=false

# Cloudflare R2 configuration:
#   - Account ID: found in R2 Dashboard overview
#   - Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   - Bucket: create a bucket in R2 Dashboard
#   - API Token: Settings > Manage API Token > Create Token
#     (needs Object Read + Object Write permissions)
#
# AWS S3 configuration:
#   - Region: your bucket region (e.g., us-east-1)
#   - Access Key: IAM > Users > Security credentials
OSS_ENDPOINT=https://your-account.r2.cloudflarestorage.com
OSS_BUCKET=node-packages
AWS_REGION=auto
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
