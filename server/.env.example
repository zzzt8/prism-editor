# ==============================================================
# Auth JWT
# ==============================================================
# Secret for signing JWT tokens (minimum 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Token expiration times
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ==============================================================
# Database connection
# ==============================================================
# SQLite (default for local dev):
DATABASE_URL="file:./dev.db"
# PostgreSQL (for production):
# DATABASE_URL="postgresql://user:password@localhost:5432/prism"

# ==============================================================
# Server
# ==============================================================
PORT=3001

# ==============================================================
# CORS
# ==============================================================
# Allow all origins in development; RESTRICT IN PRODUCTION
# For production, set to your frontend domain (e.g., https://your-app.com)
# CORS_ORIGIN="https://your-production-domain.com"
CORS_ORIGIN="*"

# ==============================================================
# Security (Production Checklist)
# ==============================================================
# 1. JWT_SECRET: Must be at least 32 characters, use a strong random value
# 2. NODE_ENV: Must be "production" to enable:
#    - Secure cookie flags
#    - Signature requirements for node packages
# 3. CORS_ORIGIN: Should NOT be "*" in production
# 4. DATABASE_URL: Use PostgreSQL with SSL in production
# 5. Rate limiting: Configured on /auth/login and /auth/register
#    (10 requests per 15 minutes per IP via @fastify/rate-limit)

# ==============================================================
# Environment
# ==============================================================
NODE_ENV=development

# ==============================================================
# OSS / Cloud Storage (Cloudflare R2 or AWS S3)
# ==============================================================
# Set OSS_ENABLED=true to enable cloud storage for large node packages
# When disabled (default), all manifests are stored in the database
OSS_ENABLED=false

# Cloudflare R2 configuration:
#   - Account ID: found in R2 Dashboard overview
#   - Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   - Bucket: create a bucket in R2 Dashboard
#   - API Token: Settings > Manage API Token > Create Token
#     (needs Object Read + Object Write permissions)
#
# AWS S3 configuration:
#   - Region: your bucket region (e.g., us-east-1)
#   - Access Key: IAM > Users > Security credentials
OSS_ENDPOINT=https://your-account.r2.cloudflarestorage.com
OSS_BUCKET=node-packages
AWS_REGION=auto
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
