{
  "name": "@prism/image-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/src/index.js",
      "node": "./dist/src/nodejs/index.js",
      "default": "./dist/src/index.js"
    },
