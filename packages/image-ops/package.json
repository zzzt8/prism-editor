{
  "name": "@prism/image-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/src/index.js",
      "node": "./dist/src/nodejs/index.js",
      "default": "./dist/src/index.js"
    },
    "./apply-mask": "./dist/src/apply-mask.js",
    "./composite": "./dist/src/composite.js",
    "./export-image": "./dist/src/export-image.js",
    "./nodejs": "./dist/src/nodejs/index.js",
    "./sharp-utils": "./dist/src/nodejs/sharp-utils.js",
    "./browser": {
      "browser": "./dist/src/browser-entry.js",
      "default": "./dist/src/browser-entry.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "verify:m0": "node --import tsx _m0_evidence/spike/spike-runner.ts && node --import tsx _m0_evidence/driver/m0-driver.ts && vitest run _m0_evidence/mutation/m0-mutation.test.ts && vitest run _m0_evidence/alpha/alpha-regression.test.ts",
    "verify:m0:node-parity-only": "vitest run src/dual-executor-consistency.test.ts",
    "verify:m0:alpha-only": "vitest run _m0_evidence/alpha/alpha-regression.test.ts",
    "verify:m0:mutation-only": "vitest run _m0_evidence/mutation/m0-mutation.test.ts",
    "verify:m0:spike-only": "node --import tsx _m0_evidence/spike/spike-runner.ts",
    "verify:m0:driver-only": "node --import tsx _m0_evidence/driver/m0-driver.ts"
  },
  "dependencies": {
    "@prism/shared-types": "workspace:*",
    "comlink": "^4.4.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@prism/workflow-core": "workspace:*",
    "@vitest/browser": "^1.6.0",
    "playwright": "^1.44.0",
    "vitest": "^1.6.0"
  }
}
