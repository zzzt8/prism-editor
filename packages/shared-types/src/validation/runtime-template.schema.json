{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prism-editor.local/schemas/runtime-template.schema.json",
  "title": "Prism RuntimeTemplate",
  "description": "Public runtime template description. Distinct from the legacy Template (EditorDraft snapshot) — exposes only versioned inputs and flows, never internal DAG structure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "schemaVersion",
    "displayName",
    "inputs",
    "flows",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "version": { "type": "string", "minLength": 1, "maxLength": 256 },
    "schemaVersion": { "type": "integer", "const": 1 },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 256 },
    "inputs": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/definitions/inputField" }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/flow" }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "definitions": {
    "inputField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "required"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,127}$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "image",
            "mask",
            "asset",
            "json"
          ]
        },
        "required": { "type": "boolean" },
        "defaultValue": true,
        "editableSchema": { "type": "object" }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flowKey", "nodes"],
      "properties": {
        "flowKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,255}$"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      }
    }
  }
}
