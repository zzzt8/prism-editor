      cx="16"
      cy="16"
      r="14.75"
      stroke="var(--accent-primary, #6366F1)"
      stroke-dasharray="69.50773746067418 92.6769832808989"
      stroke-linecap="round"
      stroke-width="2.5"
      style="transform-origin: center;"
    />
  </svg>
</span>
`;

