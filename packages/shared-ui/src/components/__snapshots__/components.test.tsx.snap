    aria-hidden="true"
    fill="none"
    height="32"
    viewBox="0 0 32 32"
    width="32"
  >
    <circle
      cx="16"
      cy="16"
      r="14.75"
      stroke="var(--border-default, #3A3A3D)"
      stroke-width="2.5"
