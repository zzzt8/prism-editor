  "dependencies": {
    "@prism/shared-types": "workspace:*",
    "@prism/workflow-core": "workspace:*"
  },
  "devDependencies": {
    "@vitest/browser": "^1.6.0",
    "playwright": "^1.44.0",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "@prism/image-ops": "workspace:*"
  }
